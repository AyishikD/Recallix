@startuml High_Level_Architecture
title Recallic — high-level architecture (no LLM in the memory pipeline)

actor "Client / Agent\n(SDK, RAG app, dashboard)" as Client

package "API process (Python, FastAPI)" {
  [Auth\n(hashed API keys, roles,\nper-user rate limit)] as Auth
  [MemoryManager\nstore / delete / clear] as MM
  [RecallEngine\ncandidates → learned ranker\n→ truth arbitration → abstain] as RE
  [IndexSync\nrebuild indexes from SQLite] as Sync
  [Scheduler\nstate inference · prediction\nreplay · forgetting] as Jobs
}

database "SQLite (storage.root)\nsystem of record:\nmemories + embeddings, FTS5,\nlong-term, timeline, reflections,\nworld state, recall log, archive" as DB

node "Vector engine (C++)\none HNSW index per user\nNEON / AVX2 dot product" as Engine
cloud "Embedding provider\n(ollama | local | API)" as Emb

Client --> Auth : HTTPS + X-API-Key
Auth --> MM
Auth --> RE
MM --> Emb : 1 embedding per store
RE --> Emb : 1 embedding per recall
MM --> DB
RE --> DB : FTS5 + batched reads
MM --> Engine : /add (namespace = user)
RE --> Engine : /search
Sync --> Engine : /configure /bulk_add /drop
Sync --> DB
Jobs --> DB
Jobs --> MM
Engine ..> Sync : X-Engine-Instance change\n(restart) triggers rebuild

@enduml

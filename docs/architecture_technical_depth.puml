@startuml Technical_Depth
title Recallic — store and recall pipelines

partition "POST /memory/store" {
  :acting user from API key (service/admin may pass user_id);
  :per-user write rate limit;
  :dedupe: identical content visible to this agent? -> skip;
  :embed once (SemanticMemory, LRU cache);
  :fact slots (rule grammar, precision guard);
  :schema (prototype classifier on the embedding);
  :importance = 1 + 9·sigmoid(w·[novelty, IDF, specificity, cues]);
  :SQLite insert (row + embedding + FTS5) and timeline entry;
  :engine /add (pending vectors are searchable immediately);
  if (importance >= memory.long_term_min_importance) then (yes)
    :promote to long-term facts;
  endif
}

partition "POST /memory/recall" {
  :alias expansion from stored "X is also known as Y" facts;
  :embed query once;
  :candidates: FTS5 + entity index (SQL, agent-visible)\n+ user's HNSW namespace (batched SQLite fetch);
  :features: semantic, lexical, entity match/conflict,\nrelation match/conflict, slot match, salience, recency, alias bridge;
  :relevance = sigmoid(w·x)  (weights + threshold fitted by CV);
  :TruthEngine: newest value per fact slot, value-specific negation;
  :multi-hop ("contains" / "powered by" / "depends on");
  if (top relevance < learned threshold) then (yes)
    :status ABSTAINED, return nothing;
  else (no)
    :return top-k with explain breakdown;
  endif
  :log candidate features (for /memory/feedback training);
}

@enduml
